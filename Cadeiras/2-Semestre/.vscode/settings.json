{
    "chat.editor.wordWrap": "on",
    "chat.disableAIFeatures": true,
    "chat.viewSessions.enabled": false,
    "chat.agent.enabled": false,
    "chat.contextUsage.enabled": false,

    "color-highlight.languages": ["*"],
    "color-highlight.markerType": "dot-before",

    "debug.allowBreakpointsEverywhere": true,

    "diffEditor.maxComputationTime": 0,
    "diffEditor.renderSideBySide": true,
    "diffEditor.codeLens": true,
    "diffEditor.ignoreTrimWhitespace": false,

    "editor.suggestOnTriggerCharacters": true,
    "editor.tabCompletion": "on",
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.autoClosingBrackets": "always",
    "editor.autoClosingQuotes": "always",
    "editor.colorDecoratorsActivatedOn": "click",
    "editor.fontSize": 17,
    "eslint.format.enable": true,
    "editor.formatOnSave": true,
    "editor.fontLigatures": true,
    "editor.fontFamily": "'Consolas ligaturized v3', 'Droid Sans Mono', 'Fira Code', monospace",
    "editor.inlayHints.fontFamily": "'Arial'",
    "editor.linkedEditing": true,
    "editor.mouseWheelZoom": true,
    "editor.mouseWheelScrollSensitivity": 2,
    "editor.inlineSuggest.enabled": false,
    "editor.inlineSuggest.edits.allowCodeShifting": "never",
    "editor.inlineSuggest.edits.renderSideBySide": "never",
    "editor.inlineSuggest.edits.showLongDistanceHint": false,
    "editor.inlineSuggest.suppressSuggestions": true,
    "editor.minimap.enabled": false,
    "editor.quickSuggestions": {
        "strings": "on",
        "other": "on",
        "comments": "on",
    },
    "editor.wordWrap": "on",
    "editor.wordWrapColumn": 200,

    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "explorer.sortOrder": "default",
    "explorer.confirmPasteNative": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*",
    },

    "files.autoSave": "onFocusChange",
    "files.associations": {
        "*.js": "javascriptreact",
    },
    "files.exclude": {
        "**/dist/*": true,
        "**/vite.config.js": true,
    },

    "http.systemCertificatesNode": true,
    "html.format.wrapAttributes": "auto",
    "html.format.wrapLineLength": 0,

    "security.workspace.trust.untrustedFiles": "open",
    // "settingsSync.ignoredSettings": ["-window.zoomLevel"],

    // "terminal.integrated.automationProfile.linux": {},
    "terminal.integrated.env.linux": {},
    "terminal.integrated.mouseWheelZoom": true,
    "terminal.integrated.defaultLocation": "editor",
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorWidth": 2,
    "terminal.integrated.customGlyphs": false,
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.lineHeight": 1,
    "terminal.integrated.letterSpacing": 0.1,
    "terminal.integrated.fastScrollSensitivity": 3,
    "terminal.integrated.fontFamily": "'Consolas ligaturized v3'",
    "terminal.integrated.env.windows": {},
    "terminal.integrated.initialHint": false,
    "terminal.integrated.fontSize": 17,

    "window.title": "${activeEditorMedium}${separator}${rootName}",
    "window.zoomLevel": 0.7,
    "window.restoreWindows": "preserve",
    "window.menuBarVisibility": "compact",
    "window.commandCenter": false,

    "workbench.startupEditor": "none",
    "workbench.list.mouseWheelScrollSensitivity": 3,
    "workbench.settings.applyToAllProfiles": ["window.zoomLevel"],
    "workbench.statusBar.visible": true,
    "workbench.preferredDarkColorTheme": "Monospace Dark",
    "workbench.externalBrowser": "'chrome'",
    "workbench.trustedDomains.promptInTrustedWorkspace": true,
    "workbench.layoutControl.enabled": false,
    "workbench.browser.showInTitleBar": true,
    "workbench.sideBar.location": "right",
    "workbench.editor.empty.hint": "hidden",
    "workbench.colorTheme": "Monospace Dark",
    "workbench.iconTheme": "charmmono-icon-theme",
    "workbench.editorAssociations": {
        "*.sqlite": "sqlite3-editor.editor",
    },
    "workbench.experimental.modernUI": true,
    "workbench.activityBar.location": "top",
    "workbench.secondarySideBar.defaultVisibility": "hidden",

    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true,
        },
    },
    "[java]": {
        "editor.defaultFormatter": "redhat.java",
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },

    "git.confirmSync": false,
    "git.openRepositoryInParentFolders": "never",
    "git.suggestSmartCommit": true,
    "git.ignoreRebaseWarning": true,

    // Java
    "java.configuration.runtimes": [],
    "java.project.sourcePaths": ["src"],
    "java.project.outputPath": "bin",
    "java.project.referencedLibraries": ["lib/**/*.jar"],
    "redhat.telemetry.enabled": false,
    "maven.executable.preferMavenWrapper": false,

    // Extensões
    "antigravity.enableTelemetry": false,
    "eslint.quiet": true,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "liveServer.settings.donotShowInfoMsg": true,
    "liveServer.settings.donotVerifyTags": true,
    "liveServer.settings.CustomBrowser": "chrome",

    "prettier.tabWidth": 4,
    "prettier.singleQuote": true,
    "prettier.trailingComma": "all",
    "sqlite3-editor.ui.minimizePanel": true,
}
